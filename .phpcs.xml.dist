<?xml version="1.0"?>
<ruleset name="Atlas Theme">
	<description>Coding standards for the Atlas WP multipurpose parent theme (WordPress + WordPress-Extra, PHP 8.1 compatibility).</description>

	<!-- Scan the theme source only. -->
	<file>theme/</file>

	<!-- Never scan tooling or build output. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.worktrees/*</exclude-pattern>
	<!-- theme/build/ is generated by @wordpress/scripts (gitignored); its
	     *.asset.php files are machine-generated and must not be linted. -->
	<exclude-pattern>*/theme/build/*</exclude-pattern>

	<!-- Show progress and sniff codes; only sniff PHP. -->
	<arg value="ps"/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<!-- Warnings are advisory: they are reported but do NOT fail the run
	     (so pre-commit and CI gate on errors, not warnings). Errors still
	     fail as normal. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<!-- WordPress Coding Standards. -->
	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>

	<!-- PHP cross-version compatibility: PHP 8.1 and up. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Minimum supported WordPress version. -->
	<config name="minimum_wp_version" value="6.8"/>
	<config name="minimum_supported_wp_version" value="6.8"/>

	<!-- Enforce the project text domain for i18n sniffs. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="atlas-theme"/>
			</property>
		</properties>
	</rule>

	<!-- Enforce the project global prefixes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="atlas"/>
				<element value="Atlas"/>
				<element value="ATLAS"/>
			</property>
		</properties>
		<!-- Hook names are passed as class constants (e.g. self::FILTER_ENABLED =
		     'atlas_...') per coding-standards §7 (semantic strings as constants).
		     The sniff cannot resolve the constant's value, so it cannot see the
		     'atlas_' prefix and false-positives on every dynamic hook name. The
		     constants ARE correctly prefixed, so this sub-sniff is excluded. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.DynamicHooknameFound"/>
	</rule>

	<!-- base64_encode() is used only to encode random_bytes() into a CSP nonce
	     (Atlas\Assets::get_csp_nonce) — a legitimate, non-obfuscation use. The
	     "discouraged function" warning does not apply here, so it is excluded. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
		<severity>0</severity>
	</rule>
</ruleset>
