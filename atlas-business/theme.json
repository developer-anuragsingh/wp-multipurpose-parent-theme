{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "color": "#0f172a", "name": "Executive Slate" },
        { "slug": "accent", "color": "#2563eb", "name": "Sapphire Blue" },
        { "slug": "accent-text", "color": "#1d4ed8", "name": "Sapphire Blue (text-safe)" },
        { "slug": "accent-emerald", "color": "#059669", "name": "Emerald Growth" },
        { "slug": "dark", "color": "#0f172a", "name": "Deep Slate" },
        { "slug": "light", "color": "#f8fafc", "name": "Subtle Light Surface" },
        { "slug": "white", "color": "#ffffff", "name": "Pure White" },
        { "slug": "surface", "color": "#ffffff", "name": "Surface" },
        { "slug": "surface-tint", "color": "#f1f5f9", "name": "Surface Tint" },
        { "slug": "border", "color": "#e2e8f0", "name": "Clean Border" },
        { "slug": "muted", "color": "#64748b", "name": "Muted Slate" }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Subtle",
          "slug": "subtle",
          "shadow": "0 1px 3px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.03)"
        },
        {
          "name": "Card",
          "slug": "card",
          "shadow": "0 4px 6px -1px rgba(15, 23, 42, 0.05), 0 2px 4px -2px rgba(15, 23, 42, 0.03)"
        },
        {
          "name": "Elevated",
          "slug": "elevated",
          "shadow": "0 12px 28px -4px rgba(15, 23, 42, 0.08), 0 4px 10px -4px rgba(15, 23, 42, 0.04)"
        },
        {
          "name": "Floating",
          "slug": "floating",
          "shadow": "0 24px 48px -12px rgba(15, 23, 42, 0.12), 0 8px 16px -6px rgba(15, 23, 42, 0.06)"
        }
      ]
    },
    "typography": {
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.75rem",
          "fluid": { "min": "0.75rem", "max": "0.8125rem" }
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "0.875rem",
          "fluid": { "min": "0.875rem", "max": "0.9375rem" }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1rem",
          "fluid": { "min": "1rem", "max": "1.125rem" }
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "1.25rem",
          "fluid": { "min": "1.25rem", "max": "1.5rem" }
        },
        {
          "slug": "xx-large",
          "name": "Extra Extra Large",
          "size": "1.625rem",
          "fluid": { "min": "1.625rem", "max": "2.125rem" }
        },
        {
          "slug": "display",
          "name": "Display Hero",
          "size": "2.75rem",
          "fluid": { "min": "2.125rem", "max": "3.5rem" }
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|light",
      "text": "var:preset|color|dark"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        ":hover": {
          "color": { "background": "var:preset|color|accent" }
        },
        "border": {
          "radius": "9999px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.625rem",
            "right": "1.625rem"
          }
        },
        "typography": {
          "fontWeight": "600",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "letterSpacing": "-0.035em",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "letterSpacing": "-0.025em",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "letterSpacing": "-0.02em",
          "lineHeight": "1.25"
        }
      }
    }
  }
}
