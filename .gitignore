.DS_Store
Thumbs.db
node_modules/
vendor/
*.log
.idea/

# Share only the team-wide VS Code config; ignore personal/local VS Code files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Font binaries are not committed; only the directory placeholder is tracked
theme/assets/fonts/*.woff2

# Workflow worktrees and agent task artifacts (not part of the theme)
.worktrees/
.agents/
