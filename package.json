{
  "name": "atlas-wp-multipurpose-parent-theme",
  "version": "1.0.0",
  "description": "Dev tooling for the Atlas FSE parent theme: @wordpress/scripts lint/build plus husky + lint-staged pre-commit gates.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "lint:js": "wp-scripts lint-js theme/src/js",
    "lint:css": "wp-scripts lint-style \"theme/src/css/**/*.css\"",
    "build": "wp-scripts build --experimental-modules",
    "start": "wp-scripts start --experimental-modules",
    "test": "node --test 'tests/js/**/*.test.js'",
    "test:e2e": "playwright test",
    "create-child": "bash scripts/create-child-theme.sh",
    "commitlint": "commitlint --from=HEAD~1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.57.0",
    "@wordpress/scripts": "^36.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0"
  },
  "lint-staged": {
    "theme/**/*.php": "vendor/bin/phpcs --standard=.phpcs.xml.dist",
    "theme/src/js/**/*.{js,jsx,ts,tsx}": "wp-scripts lint-js",
    "theme/src/css/**/*.css": "wp-scripts lint-style"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions",
    "not dead",
    "not ie > 0"
  ]
}
