{
  "name": "nexus-wp-multipurpose-parent-theme",
  "version": "1.0.0",
  "description": "Dev tooling for the Nexus FSE parent theme: @wordpress/scripts lint/build plus husky + lint-staged pre-commit gates.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "lint:js": "wp-scripts lint-js theme/src/js",
    "lint:css": "wp-scripts lint-style \"theme/src/css/**/*.css\"",
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@wordpress/scripts": "^36.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.php": "composer lint --",
    "theme/src/js/**/*.{js,jsx,ts,tsx}": "wp-scripts lint-js",
    "theme/src/css/**/*.css": "wp-scripts lint-style"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions",
    "not dead",
    "not ie > 0"
  ]
}
