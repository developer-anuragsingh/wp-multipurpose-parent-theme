{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "link": true,
      "palette": [
        { "slug": "primary", "color": "#2563eb", "name": "Primary Blue" },
        { "slug": "accent", "color": "#f97316", "name": "Accent Orange" },
        { "slug": "accent-text", "color": "#c2410c", "name": "Accent Orange (text-safe)" },
        { "slug": "dark", "color": "#0f172a", "name": "Dark Navy" },
        { "slug": "light", "color": "#f8fafc", "name": "Light Surface" },
        { "slug": "white", "color": "#ffffff", "name": "Pure White" },
        { "slug": "surface", "color": "#ffffff", "name": "Surface (white, dark-mode aware)" },
        { "slug": "link", "color": "#2563eb", "name": "Link (dark-mode aware)" },
        { "slug": "muted", "color": "#64748b", "name": "Muted Slate" },
        { "slug": "border", "color": "#e2e8f0", "name": "Clean Border" },
        { "slug": "surface-tint", "color": "#f1f5f9", "name": "Surface Tint" },
        { "slug": "success", "color": "#10b981", "name": "Success Emerald" },
        { "slug": "warning", "color": "#f59e0b", "name": "Warning Amber" },
        { "slug": "danger", "color": "#ef4444", "name": "Danger Red" }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Subtle",
          "slug": "subtle",
          "shadow": "0 1px 3px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.03)"
        },
        {
          "name": "Card",
          "slug": "card",
          "shadow": "0 4px 6px -1px rgba(15, 23, 42, 0.05), 0 2px 4px -2px rgba(15, 23, 42, 0.03)"
        },
        {
          "name": "Elevated",
          "slug": "elevated",
          "shadow": "0 12px 28px -4px rgba(15, 23, 42, 0.08), 0 4px 10px -4px rgba(15, 23, 42, 0.04)"
        },
        {
          "name": "Floating",
          "slug": "floating",
          "shadow": "0 24px 48px -12px rgba(15, 23, 42, 0.12), 0 8px 16px -6px rgba(15, 23, 42, 0.06)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontStyle": true,
      "fontWeight": true,
      "lineHeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true,
      "dropCap": false,
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.75rem",
          "fluid": { "min": "0.75rem", "max": "0.8125rem" }
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "0.875rem",
          "fluid": { "min": "0.875rem", "max": "0.9375rem" }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1rem",
          "fluid": { "min": "1rem", "max": "1.125rem" }
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "1.25rem",
          "fluid": { "min": "1.25rem", "max": "1.5rem" }
        },
        {
          "slug": "xx-large",
          "name": "Extra Extra Large",
          "size": "1.625rem",
          "fluid": { "min": "1.625rem", "max": "2.125rem" }
        },
        {
          "slug": "display",
          "name": "Display Hero",
          "size": "2.75rem",
          "fluid": { "min": "2.125rem", "max": "3.5rem" }
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "\"Inter\", system-ui, sans-serif",
          "slug": "body",
          "name": "Body",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/inter-variable.woff2"]
            }
          ]
        },
        {
          "fontFamily": "\"Sora\", system-ui, sans-serif",
          "slug": "heading",
          "name": "Heading",
          "fontFace": [
            {
              "fontFamily": "Sora",
              "fontWeight": "600 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/sora-variable.woff2"]
            }
          ]
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "padding": true,
      "margin": true,
      "blockGap": true,
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "X-Small", "size": "0.5rem" },
        { "slug": "30", "name": "Small", "size": "0.75rem" },
        { "slug": "40", "name": "Medium", "size": "1rem" },
        { "slug": "50", "name": "Large", "size": "1.5rem" },
        { "slug": "60", "name": "X-Large", "size": "clamp(1.5rem, 4vw, 2.25rem)" },
        { "slug": "70", "name": "2X-Large", "size": "clamp(2rem, 5vw, 3rem)" },
        { "slug": "80", "name": "3X-Large", "size": "clamp(2.5rem, 7vw, 4rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|light",
      "text": "var:preset|color|dark"
    },
    "spacing": {
      "padding": {
        "left": "clamp(1rem, 4vw, 2rem)",
        "right": "clamp(1rem, 4vw, 2rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|link" },
        ":hover": {
          "color": { "text": "var:preset|color|dark" }
        },
        "typography": { "textDecoration": "underline" }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        ":hover": {
          "color": { "background": "var:preset|color|dark" }
        },
        ":focus": {
          "color": { "background": "var:preset|color|dark" }
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|30",
            "bottom": "var:preset|spacing|30",
            "left": "var:preset|spacing|40",
            "right": "var:preset|spacing|40"
          }
        },
        "border": { "radius": "0.375rem" }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "fontSize": "var:preset|font-size|small",
          "textTransform": "uppercase"
        }
      }
    },
    "blocks": {
      "core/heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "lineHeight": "1.2"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "footer-landing", "title": "Footer (Landing)", "area": "footer" },
    { "name": "notifications", "title": "Notifications", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "blank", "title": "Blank / Landing", "postTypes": ["page"] },
    { "name": "maintenance", "title": "Maintenance / 503", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact Us (Full Suite)", "postTypes": ["page"] },
    { "name": "page-no-title", "title": "Page (No Title)", "postTypes": ["page"] }
  ]
}
