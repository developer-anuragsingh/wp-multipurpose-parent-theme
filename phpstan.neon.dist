# Static analysis for the theme PHP. Run: composer analyse
includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
  level: 5
  phpVersion: 80100
  paths:
    - theme/functions.php
    - theme/inc
    - theme/patterns
  bootstrapFiles:
    - tests/phpstan/bootstrap.php
  # WordPress does not enforce PHPDoc types: a filter can return anything, so
  # the theme re-checks types after apply_filters(). Trust only native types.
  treatPhpDocTypesAsCertain: false
  ignoreErrors:
    # The stubs model WP_Customize_Control args as array{settings?: array},
    # but core accepts a setting ID string there (WP_Customize_Control::__construct).
    -
      identifier: argument.type
      path: theme/inc/forms/class-contact-settings.php
      message: '#WP_Customize_Manager#'
    # Defensive isset() on WP_Post / WP_Term properties: the stubs say they are
    # never null, but the theme also receives filtered or partial objects.
    -
      identifier: isset.property
    # theme/build/ is generated by `npm run build` and gitignored; CI analyses
    # the source without building it.
    -
      identifier: require.fileNotFound
      message: '#/build/#'
      reportUnmatched: false
    # COOKIE_DOMAIN defaults to false in core (wp_cookie_constants()); the
    # extension types it as string, so the is_string() guard is needed.
    -
      message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
      path: theme/inc/core/class-i18n.php
      count: 1
    # store() and purge_expired() return the post ID / purge count so tests and
    # callers can use it; WordPress ignores an action callback's return value.
    -
      message: '#^Action callback returns int but should not return anything\.$#'
      path: theme/inc/forms/class-submissions.php
