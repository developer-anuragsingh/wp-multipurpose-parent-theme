{
  "name": "atlas/wp-multipurpose-parent-theme",
  "description": "Dev tooling for the Atlas FSE parent theme: PHP_CodeSniffer with WordPress Coding Standards and PHPCompatibilityWP (PHP 8.1).",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require": {},
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "wp-phpunit/wp-phpunit": "7.1.*",
    "roots/wordpress-no-content": "7.1.*"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.1"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "php tests/run-tests.php",
    "test:wp": "phpunit -c phpunit-wp.xml.dist",
    "test:wp:local": "bash scripts/test-wp-local.sh"
  }
}
